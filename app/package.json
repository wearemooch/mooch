{
  "name": "mooch",
  "productName": "mooch",
  "version": "0.1.0",
  "private": true,
  "description": "The coding agent that runs on other people’s free tiers.",
  "license": "GPL-3.0-or-later",
  "author": "mooch contributors",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n main,web,app \"npm:watch:main\" \"vite\" \"npm:start:dev\"",
    "watch:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "start:dev": "wait-on tcp:5173 out/main/index.js out/preload/index.js && cross-env FREE_CODE_DEV_URL=http://localhost:5173 electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "stage": "node scripts/stage.mjs",
    "pack": "npm run typecheck && npm test && npm run build && npm run stage && electron-builder --win --dir --publish never",
    "dist": "npm run typecheck && npm test && npm run build && npm run stage && electron-builder --win --publish never",
    "codex:types": "codex app-server generate-ts --experimental --out src/main/codex/protocol",
    "smoke:backend": "npm run build:main && node scripts/smoke-backend.mjs",
    "smoke:app": "npm run build && electron scripts/smoke-electron.cjs",
    "dist:mac": "npm run typecheck && npm test && npm run build && npm run stage && electron-builder --mac --publish never",
    "dist:linux": "npm run typecheck && npm test && npm run build && npm run stage && electron-builder --linux --publish never"
  },
  "dependencies": {
    "diff": "9.0.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@openai/codex": "0.162.1",
    "@phosphor-icons/react": "2.1.10",
    "@types/node": "20.19.21",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "material-icon-theme": "5.39.0",
    "monaco-editor": "0.53.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7",
    "wait-on": "9.0.1",
    "zustand": "5.0.8"
  },
  "build": {
    "appId": "app.mooch.desktop",
    "productName": "mooch",
    "copyright": "Copyright © 2026 mooch contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/**/*.test.js",
      "!out/**/*.map",
      "prompts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/stage",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "mooch",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "synopsis": "A code editor with a free coding agent",
      "maintainer": "mooch contributors",
      "syncDesktopName": true
    }
  },
  "desktopName": "mooch.desktop",
  "homepage": "https://github.com/wearemooch/mooch",
  "repository": {
    "type": "git",
    "url": "https://github.com/wearemooch/mooch.git"
  },
  "bugs": {
    "url": "https://github.com/wearemooch/mooch/issues"
  }
}
